# Copy to .env and fill in. Never commit .env.

# DJI Open API "App Key" (developer.dji.com → Apps → your Open API app).
# Required only for encrypted logs (format v13+, i.e. current DJI Fly / DJI GO
# logs). Leave empty to view older logs only.
DJI_API_KEY=

# Host port the viewer is published on (http://localhost:8080).
PORT=8080

# Maximum size of a single uploaded log, in MB.
MAX_UPLOAD_MB=200

# Map tiles. The default uses the public OpenStreetMap tile servers, which are
# fine for personal use (https://operations.osmfoundation.org/policies/tiles/).
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Elevation tiles for the 3D view (default: public AWS Terrain Tiles).
# Set to "off" for a flat 3D view without terrain.
# MAP_TERRAIN_URL=https://s3.amazonaws.com/elevation-tiles-prod/terrarium/{z}/{x}/{y}.png

# Vector tiles (OpenMapTiles schema) for 3D buildings and woods
# (default: OpenFreeMap). Set to "off" to disable.
# MAP_VECTOR_TILES_URL=https://tiles.openfreemap.org/planet

# On-demand 3D obstacle layers (fetched only when switched on in the map).
# Single trees from OpenStreetMap (Overpass API); "off" disables.
# OVERPASS_URL=https://overpass-api.de/api/interpreter
# Poland only: GUGiK terrain (NMT) and surface (NMPT) GeoTIFF requests with
# {minE} {minN} {maxE} {maxN} in EPSG:2180; "off" disables.
# GUGIK_NMT_URL=...
# GUGIK_NMPT_URL=...

# Log level: error, warn, info, debug.
RUST_LOG=info
