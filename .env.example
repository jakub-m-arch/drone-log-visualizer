# Copy to .env and fill in. Never commit .env.

# DJI Open API "App Key" (developer.dji.com → Apps → your Open API app).
# Required only for encrypted logs (format v13+, i.e. current DJI Fly / DJI GO
# logs). Leave empty to view older logs only.
DJI_API_KEY=

# Host port the viewer is published on (http://localhost:8080).
PORT=8080

# Maximum size of a single uploaded log, in MB.
MAX_UPLOAD_MB=200

# Map tiles. The default uses the public OpenStreetMap tile servers, which are
# fine for personal use (https://operations.osmfoundation.org/policies/tiles/).
# MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Log level: error, warn, info, debug.
RUST_LOG=info
